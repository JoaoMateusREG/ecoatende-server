{
  "name": "ecoatende",
  "version": "0.0.1",
  "description": "ecoatende-api",
  "author": "joao-mateus",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "docker compose up -d redis && nest start",
    "start:dev": "docker compose up -d redis && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:organization": "jest --config ./test/jest-organization.json",
    "db:seed": "ts-node prisma/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f redis"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@nestjs/common": "11.1.17",
    "@nestjs/core": "11.1.18",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/swagger": "11.2.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/client": "6.19.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/redis": "^4.0.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "axios": "1.15.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "prisma": "6.19.3",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "11.1.1",
    "ws": "^8.20.1"
  },
  "overrides": {
    "defu": "6.1.5",
    "follow-redirects": "1.16.0",
    "path-to-regexp": "8.4.0",
    "picomatch": "2.3.2",
    "qs": "6.14.2",
    "socket.io-parser": "4.2.6",
    "validator": "13.15.22",
    "@isaacs/brace-expansion": "5.0.1",
    "serialize-javascript": "7.0.5"
  },
  "resolutions": {
    "defu": "6.1.5",
    "follow-redirects": "1.16.0",
    "path-to-regexp": "^8.4.0",
    "picomatch": "^4.0.4",
    "qs": "^6.14.2",
    "socket.io-parser": "4.2.6",
    "validator": "13.15.22",
    "@isaacs/brace-expansion": "5.0.1",
    "serialize-javascript": "7.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@isaacs/brace-expansion": "5.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.19",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "defu": "6.1.5",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "follow-redirects": "1.16.0",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "path-to-regexp": "8.4.0",
    "picomatch": "2.3.2",
    "prettier": "^3.8.3",
    "qs": "6.14.2",
    "serialize-javascript": "7.0.5",
    "socket.io-parser": "4.2.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "validator": "13.15.22"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
