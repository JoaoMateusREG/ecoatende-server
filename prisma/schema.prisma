// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CardStatus {
  WAITING
  CALLED
  IN_ATTENDANCE
  FINISHED
}

enum CardPriority {
  NORMAL
  PREFERENTIAL
  URGENT
}

enum UserRole {
  ADMIN
  ORGANIZATION_ADMIN
  USER
}

model Organization {
  cnpj           String        @id @unique
  name           String
  email          String        @unique
  phone          String
  creationDate   DateTime      @default(now())
  users          User[]
  cards          Card[]
  services       Service[]
  payments       Payment[]
  subscription   Subscription[]
  customerId     String?       @unique
  active         Boolean?      @default(true)
  logo           String?
  gracePeriodDays Int?
}

model User {
  cpf              String       @id @unique
  name             String
  password         String
  role             UserRole     @default(USER)
  organization     Organization @relation(fields: [organizationCnpj], references: [cnpj])
  organizationCnpj String
  services         Service[]    @relation("UserServices")
  cards            Card[]       @relation("UserCards")
  picture          String?
  isActive         Boolean?     @default(true)
}

model Service {
  id               Int          @id @default(autoincrement())
  name             String
  prefix           String       @db.VarChar(2)
  organization     Organization @relation(fields: [organizationCnpj], references: [cnpj])
  organizationCnpj String
  canCreateCards   Boolean      @default(true)
  cardLimit        Int?         @default(150)
  category         String?
  color            String?
  users            User[]       @relation("UserServices")
  cards            Card[]
}

model Card {
  id                Int          @id @default(autoincrement())
  card              String
  priority          CardPriority @default(NORMAL)
  status            CardStatus   @default(WAITING)
  datehour          DateTime     @default(now())
  datehourAttend    DateTime?
  concluded         Boolean      @default(false)
  datehourConcluded DateTime?
  organization      Organization @relation(fields: [organizationCnpj], references: [cnpj])
  organizationCnpj  String
  service           Service      @relation(fields: [serviceId], references: [id],  onDelete: Cascade)
  serviceId         Int
  user              User?        @relation("UserCards", fields: [userCpf], references: [cpf])
  userCpf           String?
}

model Subscription {
  id               String       @id
  dateCreated      String     
  customer         String       
  value            Float
  nextDueDate      String
  cycle            String
  billingType      String?
  status           String?
  organization     Organization @relation(fields: [organizationCnpj], references: [cnpj])
  organizationCnpj String
  payments         Payment[]
}

model Payment {
  id                    String       @id
  dateCreated           String    
  customer              String
  organization          Organization @relation(fields: [organizationCnpj], references: [cnpj])
  organizationCnpj      String
  subscription          Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId        String
  dueDate               String
  originalDueDate       String
  value                 Float
  netValue              Float
  originalValue         Float?
  billingType           String
  status                String
  invoiceUrl            String?
  transactionReceiptUrl String?
}
